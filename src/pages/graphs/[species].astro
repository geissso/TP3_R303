---
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";
import { penguinIcon, speciesColors } from "../../utils/Penguins.js";

export function getStaticPaths() {
  return ["Adelie", "Chinstrap", "Gentoo"].map((species) => ({
    params: { species },
  }));
}

const { species } = Astro.params;
const filtered = penguins.filter((p) => p.species === species);
const icon = penguinIcon(speciesColors[species]);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>{species}</title>
  </head>
  <body>
    <h1>Manchots {species}</h1>
    <PlotFigure
      options={{
        marks: [
          Plot.image(filtered, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            src: () => icon,
            width: 20,
            height: 20
          })
        ]
      }}
    />
  </body>
</html>
