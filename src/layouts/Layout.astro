---
import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Les graphiques à pingouins</title>
  </head>
  <body>
        <nav class="site-nav">
      <a href="/" class="site-logo" aria-label="Accueil">🐧</a>
      <a href="/AllSpecies" class="nav-link">Toutes les espèces</a>
      <select id="species" class="nav-link">
        <option value="Adelie">Adelie</option>
        <option value="Chinstrap">Chinstrap</option>
        <option value="Gentoo">Gentoo</option>
      </select>
    </nav>
        <script>
      const select = document.querySelector<HTMLSelectElement>("#species");

      // présélectionne l'option de la page courante
      const current = location.pathname.split("/").filter(Boolean).pop();
      if (select && current) select.value = current;

      // navigue au changement
      select?.addEventListener("change", (evt) => {
        const value = (evt.target as HTMLSelectElement).value;
        location.pathname = "/species/" + value + "/";
      });
    </script>
    <main class="page-container"><slot /></main>
<footer class="site-footer">
  TP2 — Astro & Observable Plot
</footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
